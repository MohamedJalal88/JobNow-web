# Example environment variables for JobNow
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# NOTE: This is the Razorpay SECRET key. It must NOT have the VITE_ prefix.
# Variables with the VITE_ prefix are embedded into the client-side JavaScript bundle
# by Vite and become publicly readable by all users.
# This variable (without VITE_) is only accessible in server-side functions.
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
